generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  passwordHash String   @map("password_hash")
  role         String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Organization {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.VarChar(200)
  type               String   @db.VarChar(100)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  email              String?  @db.VarChar(255)
  phone              String?  @db.VarChar(30)
  verificationStatus String   @default("pending") @map("verification_status") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("organizations")
}

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  donorId     String    @map("donor_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  totalBudget Decimal   @map("total_budget") @db.Decimal(14, 2)
  status      String    @default("draft") @db.VarChar(30)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("projects")
}

model Wallet {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @unique @map("project_id") @db.Uuid
  donorId     String   @map("donor_id") @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  currency    String   @default("MZN") @db.Char(3)
  status      String   @default("active") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("wallets")
}

model SubWallet {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String   @map("wallet_id") @db.Uuid
  name            String   @db.VarChar(150)
  purpose         String   @db.VarChar(255)
  allocatedAmount Decimal  @default(0) @map("allocated_amount") @db.Decimal(14, 2)
  approvalLimit   Decimal  @default(0) @map("approval_limit") @db.Decimal(14, 2)
  status          String   @default("active") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sub_wallets")
}

model Payee {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(200)
  type                String   @db.VarChar(100)
  phone               String?  @db.VarChar(30)
  email               String?  @db.VarChar(255)
  bankName            String?  @map("bank_name") @db.VarChar(150)
  bankAccountNumber   String?  @map("bank_account_number") @db.VarChar(100)
  mobileMoneyProvider String?  @map("mobile_money_provider") @db.VarChar(100)
  mobileMoneyNumber   String?  @map("mobile_money_number") @db.VarChar(30)
  verificationStatus  String   @default("pending") @map("verification_status") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payees")
}

model PaymentRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  subWalletId String   @map("sub_wallet_id") @db.Uuid
  requestedBy String   @map("requested_by") @db.Uuid
  payeeId     String   @map("payee_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  purpose     String   @db.VarChar(255)
  description String?
  invoiceUrl  String?  @map("invoice_url")
  status      String   @default("pending") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("payment_requests")
}

model Transaction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentRequestId String   @unique @map("payment_request_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  subWalletId      String   @map("sub_wallet_id") @db.Uuid
  payeeId          String   @map("payee_id") @db.Uuid
  amount           Decimal  @db.Decimal(14, 2)
  transactionType  String   @map("transaction_type") @db.VarChar(30)
  status           String   @default("completed") @db.VarChar(30)
  referenceNumber  String   @unique @map("reference_number") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("transactions")
}

model LedgerEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String?  @map("transaction_id") @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  subWalletId   String?  @map("sub_wallet_id") @db.Uuid
  entryType     String   @map("entry_type") @db.VarChar(30)
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @default("MZN") @db.Char(3)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ledger_entries")
}

model Approval {
  id               String           @id @default(uuid())
  paymentRequestId String           @map("payment_request_id")
  approverId       String           @map("approver_id")
  comment          String?
  createdAt        DateTime         @default(now()) @map("created_at")
  decision         ApprovalDecision

  @@map("approvals")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum UserRole {
  donor
  recipient
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum ProjectStatus {
  draft
  active
  completed
  cancelled
}

enum WalletStatus {
  active
  frozen
  closed
}

enum SubWalletStatus {
  active
  frozen
  closed
}

enum PaymentRequestStatus {
  pending
  approved
  rejected
  frozen
  completed
}

enum TransactionType {
  payment
  refund
  adjustment
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum LedgerEntryType {
  credit
  debit
  freeze
  unfreeze
  adjustment
}

enum ApprovalDecision {
  approved
  rejected
  frozen
  needs_more_information
}
